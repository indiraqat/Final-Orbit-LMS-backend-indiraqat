# Copy this file to .env and fill in your own values.

# PostgreSQL connection string — used by the app at runtime.
# For Neon: this is the "Pooled connection" string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orbit_lms?schema=public"

# Direct (non-pooled) connection — used only by `prisma migrate`.
# For Neon: this is the "Direct connection" string (same as above minus "-pooler").
# If you're not using a pooler (e.g. local Postgres), this can be the same as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/orbit_lms?schema=public"

# Server
PORT=4000
NODE_ENV=development

# CORS — the origin your frontend runs on (e.g. Live Server, Vite, etc.)
CLIENT_ORIGIN="http://127.0.0.1:5500"

# Auth — used to sign/verify JWTs. Use a long random string in real deployments.
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
